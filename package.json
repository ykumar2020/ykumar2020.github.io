{
  "name": "julie-kumar-academic-site",
  "version": "1.0.0",
  "description": "Julie Kumar academic portfolio, built with Tailwind CSS",
  "scripts": {
    "build": "python build.py && npm run build:css && npm run build:planets",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css --watch",
    "preview": "python -m http.server 8091 --bind 127.0.0.1",
    "build:planets": "esbuild src/planets.js --bundle --minify --format=esm --target=es2020 --outfile=assets/planets.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykumar2020/ykumar2020.github.io.git"
  },
  "keywords": [],
  "author": "Julie Kumar",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ykumar2020/ykumar2020.github.io/issues"
  },
  "homepage": "https://ykumar2020.github.io/",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "private": true,
  "dependencies": {
    "three": "0.186.1"
  }
}
